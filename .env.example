# vaarta — copy to .env and edit. scripts/setup.py generates this interactively.

# Deployment
ENV=local
SELF_URL=http://localhost:8000   # browser-facing base for upload URLs (public backend URL in prod); pipeline no longer calls it
# WEB_DIST_DIR=              # path to apps/web out/ export; set → api serves the UI at /

# Pluggable backends (on-prem defaults)
STORAGE_BACKEND=local

# Pipeline execution
#   inprocess = run the STT/stitch/finalize pipeline inside the api process as
#               background jobs — single container, no worker (default).
#   worker    = defer to Postgres/procrastinate; run worker container(s) too
#               (docker compose --profile worker up -d --scale worker=N).
# Chunk state lives in the audio_chunks Postgres table (claim-based), so BOTH
# modes are safe with multiple uvicorn processes and multiple containers.
EXECUTION_MODE=inprocess
# uvicorn processes for the api container. 2+ is safe in either mode; for
# multi-container deployments prefer EXECUTION_MODE=worker (durable queue).
UVICORN_WORKERS=2
# max concurrent in-process background jobs (inprocess mode only)
BACKGROUND_JOB_CONCURRENCY=4

# Storage
#   STORAGE_BACKEND=local -> files on disk under STORAGE_ROOT (browser uploads
#     go to the API, which writes them)
#   STORAGE_BACKEND=s3    -> AWS S3 / MinIO / LocalStack
STORAGE_ROOT=./storage
# --- S3 / MinIO ---
# STORAGE_BACKEND=s3
# S3_VADED_BUCKET_NAME=vaarta-voice-records        # session audio + transcripts
# S3_NON_VADED_BUCKET_NAME=vaarta-voice-batch      # batch/single uploads
#   ^ these two are the buckets the app actually uses; both must already exist
#     (nothing creates them). S3_BUCKET is not read by anything.
# S3_ENDPOINT_URL=            # set for MinIO/LocalStack (omit for real AWS)
#   local MinIO via the compose profile: S3_ENDPOINT_URL=http://minio:9000
#   (the api resolves `minio` on the compose network; localhost would be the
#    api container's own loopback). boto3 uses path-style automatically when
#    an endpoint URL is set, so MinIO needs no further config.
# BLOB_VIA_API=true           # browser -> backend -> object store (no bucket CORS,
#                             # bucket need not be reachable from browsers).
#                             # false/unset = browser uploads straight to S3.
#                             # RECOMMENDED: only with this on does the API see
#                             # each chunk land, so chunks are transcribed as
#                             # they arrive instead of all at once at commit.
# AWS_ACCESS_KEY_ID=          # omit both if the pod/VM has an instance role/IRSA
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Database
DATABASE_URL=postgresql://scribe:scribe@127.0.0.1:5432/scribe

# Auth: real username/password login everywhere — no modes, no fake identities.
AUTH_JWT_SECRET=change-me                       # setup.py generates a random one; or: openssl rand -hex 32
WORKSPACE_ID=onprem-workspace                   # all users of this deployment share one workspace
AUTH_ISSUER=scribe.local
# --- Session auth --------------------------------------------------------
# AUTH_ACCESS_TTL_SECONDS=900                   # access JWT lifetime (15 min; middleware auto-refreshes browsers)
# AUTH_REFRESH_TTL_SECONDS=2592000              # refresh token + cookie lifetime (30 d = max idle time)
# AUTH_COOKIE_SECURE=true                       # true behind HTTPS
# AUTH_COOKIE_DOMAIN=.dev.eka.care              # span FE/BE subdomains in prod; omit locally
# AUTH_ALLOW_SIGNUP=true                        # false = lock registration
UPLOAD_URL_SIGNING_SECRET=change-me

# STT — pick ONE provider:
#   sarvam            : Sarvam Saarika API (needs SARVAM_API_KEY)
#   openai_compatible : any OpenAI-compatible /v1/audio/transcriptions server (self-hosted parrotlet, whisper servers, ...)
#   gemini / ekacare  : hosted alternatives
ECHO_DEFAULT_TRANSCRIBER_PROVIDER=sarvam
# SARVAM_API_KEY=
# --- openai_compatible example (self-hosted parrotlet / faster-whisper server / speaches / vLLM audio) ---
# ECHO_DEFAULT_TRANSCRIBER_PROVIDER=openai_compatible
# ECHO_TRANSCRIBER_BASE_URL=http://localhost:8001/v1  # POST {base}/audio/transcriptions
# ECHO_DEFAULT_TRANSCRIBER_MODEL=whisper-1      # model id as the server exposes it (or OPENAI_COMPAT_STT_MODEL)
# # ECHO_TRANSCRIBER_PATH=/audio/transcriptions  # default; override if the server mounts the endpoint elsewhere
# # ECHO_TRANSCRIBER_API_KEY=                    # optional Bearer token
# DEEPGRAM_API_KEY=

# LLM for note structuring — pick ONE provider (the model must support native tool calling):
#   openai_compatible : any OpenAI-compatible endpoint (vLLM / Ollama / LiteLLM proxy)
#   anthropic         : Claude API (needs ANTHROPIC_API_KEY)
#   openai / gemini / bedrock : hosted alternatives
# AUTH_ALLOW_PASSWORD_LOGIN=false               # hide/disable username+password on SSO deployments
# --- SSO providers: see AUTH_PROVIDERS (scribe_core/providers.py schema)
# OIDC_ISSUER=https://idp.example.gov.in/realms/vaarta
# OIDC_CLIENT_ID=vaarta
# OIDC_CLIENT_SECRET=                           # omit for a public client (PKCE only)
# OIDC_REDIRECT_URL=https://vaarta.indiaai.gov.in/connect-auth/v1/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_CLAIM_UUID=sub                           # claim -> uuid
# OIDC_CLAIM_USERNAME=email                     # claim -> username + oid
# OIDC_CLAIM_NAME=name                          # claim -> display name
# OIDC_DISPLAY_NAME=MyParichay                 # login button label: "Login with <name>"
# OIDC_POST_LOGOUT_REDIRECT=https://vaarta.indiaai.gov.in/
# # OIDC_DISCOVERY_URL=                         # override if not {issuer}/.well-known/...
# # OIDC_CA_BUNDLE=/certs/idp-ca.pem            # private/gov CA
# # OIDC_VERIFY_SSL=false                       # dev only
# --- openai_compatible example ---
# ECHO_DEFAULT_LLM_PROVIDER=openai_compatible
# ECHO_LLM_BASE_URL=http://localhost:11434/v1   # openai_compatible only
# # ECHO_LLM_API_KEY=                           # openai_compatible only (if endpoint needs one)
# # ECHO_LLM_CA_BUNDLE=/certs/<file>.pem        # endpoint behind a private CA: pem in deploy/certs/
# # ECHO_LLM_VERIFY_SSL=false                   # or disable TLS verification (dev/testing ONLY)
# ECHO_DEFAULT_LLM_MODEL=qwen3:14b
# --- anthropic example ---
ECHO_DEFAULT_LLM_PROVIDER=anthropic
ECHO_DEFAULT_LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=<paste your api key here>

# Structuring models offered in the UI's convert-template picker and accepted
# as ?model= on the AG-UI run endpoints (comma-separated, ids as the serving
# stack exposes them). The per-run choice wins; ECHO_DEFAULT_LLM_MODEL above
# stays the fallback when the client sends no model. Everything else
# (provider, temperature, keys) always comes from the env.
# STRUCTURING_MODELS=sov-105b-h200,qwen3-27b,gemma-31b

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO

# echo's PostgresClient reads these; point them at the same Postgres as DATABASE_URL
ECHO_PG_HOST=127.0.0.1
ECHO_PG_PORT=5432
ECHO_PG_DATABASE=scribe
ECHO_PG_USER=scribe
ECHO_PG_PASSWORD=scribe

DISCOVERY_SUPPORT_EMAIL=admin@example.com
