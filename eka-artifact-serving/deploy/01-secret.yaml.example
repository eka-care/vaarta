# Template only -- create the real Secret directly against the cluster so
# nothing sensitive lands in the repo.
#
#   kubectl create secret generic eka-artifact-serving-secrets -n eka-care \
#     --from-literal=ARTIFACTS_KEY="$(openssl rand -hex 32)"
#
# Put the same value in the release-pipelines repo as an environment-scoped
# secret named ARTIFACTS_KEY.
#
# To rotate without a flag day: add ARTIFACTS_KEY_NEXT with the new value,
# restart, switch CI to the new value, then drop the old one from ARTIFACTS_KEY.
apiVersion: v1
kind: Secret
metadata:
  name: eka-artifact-serving-secrets
  namespace: eka-care
type: Opaque
stringData:
  ARTIFACTS_KEY: "replace-me"
  # ARTIFACTS_KEY_NEXT: "only during a rotation"

  # Gates /artifacts/models/* -- the pass-through to LiteLLM. Separate from
  # ARTIFACTS_KEY on purpose: that one is held by CI and publishes installers,
  # this one spends GPU time on the client's network, and a leak of either
  # should not be a leak of both.
  #
  #   kubectl create secret generic eka-artifact-serving-secrets -n eka-care \
  #     --from-literal=ARTIFACTS_KEY=... \
  #     --from-literal=MODEL_PROXY_KEY="$(openssl rand -hex 32)"
  MODEL_PROXY_KEY: "replace-me"
  # MODEL_PROXY_KEY_NEXT: "only during a rotation"
  #
  # The LiteLLM virtual key, if the upstream requires one. Scope it to the two
  # models we serve rather than using LiteLLM's master key -- the proxy only
  # ever needs chat completions. Read under the same name the api uses, so
  # setting it in ekascribe-secrets serves both.
  # MODEL_API_AUTH_TOKEN: "sk-..."
