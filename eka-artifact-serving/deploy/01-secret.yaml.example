# Template only -- create the real Secret directly against the cluster so
# nothing sensitive lands in the repo.
#
#   kubectl create secret generic eka-artifact-serving-secrets -n eka-care \
#     --from-literal=ARTIFACTS_KEY="$(openssl rand -hex 32)"
#
# Put the same value in the release-pipelines repo as an environment-scoped
# secret named ARTIFACTS_KEY.
#
# To rotate without a flag day: add ARTIFACTS_KEY_NEXT with the new value,
# restart, switch CI to the new value, then drop the old one from ARTIFACTS_KEY.
apiVersion: v1
kind: Secret
metadata:
  name: eka-artifact-serving-secrets
  namespace: eka-care
type: Opaque
stringData:
  ARTIFACTS_KEY: "replace-me"
  # ARTIFACTS_KEY_NEXT: "only during a rotation"
