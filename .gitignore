__pycache__/
*.pyc
.env
.env.*
.venv/
node_modules/
dist/
# vendored SDK dists ARE the package source (no build step) — keep them tracked
!packages/scribe-client-sdk/**/dist/
!packages/scribe-client-sdk/**/dist/**
.next/
storage/
# voice2rx services/storage is a SOURCE package (not runtime blob storage) — keep tracked
!apps/api/src/voice2rx/services/storage/
!apps/api/src/voice2rx/services/storage/**
logs/
# apps/api/src/logs is a SOURCE package (not a runtime log dir) — keep it tracked
!apps/api/src/logs/
!apps/api/src/logs/**
*.egg-info/
.next/
/_to_delete/

# Filled-in Kubernetes credentials. Only the *.yaml.example templates belong
# in git; these patterns end in .yaml so they do not match the templates.
# See deploy/k8s/README.md -- the preferred path is `kubectl create secret`,
# which never writes a file at all.
deploy/k8s/*secret*.yaml
deploy/k8s/*regcred*.yaml
apps/web/.next-desktop/
apps/desktop/node_modules/
apps/desktop/.vite/
apps/desktop/out/
apps/desktop/dist/
apps/desktop/runtime/
apps/desktop/mac/build/
apps/desktop/certs/
apps/desktop/*.log
apps/desktop/electron.env
deploy/secret.yaml
# Hand-taken copies of live manifests -- these hold REAL values, unlike the
# *.yaml.example templates. Never belongs in git.
*.backup
deploy/config-map.yaml
# Legacy /data/storage snapshots -- nothing takes these any more, but old
# working copies may still have them lying around.
deploy/backups/
deploy/storage-*.tar.gz
deploy/.DS_Store
.DS_Store
artifacts/
